#!/bin/bash

# if VNCUMASK was set at docker cmdline
# apply it to the whole openbox session (and every app started from it)
if [ -n "${VNCUMASK}" ]; then
  umask "${VNCUMASK}"
fi

# Skip the GTK accessibility bridge: there is no AT-SPI bus in the container,
# so every GTK app would log "AT-SPI: Error retrieving accessibility bus address"
export NO_AT_BRIDGE=1

# Show a startup notice left by app/user.sh (e.g. replaced variables)
if [ -s /tmp/ubuntu-desktop-notice.txt ]; then
  xmessage -center -file /tmp/ubuntu-desktop-notice.txt &
fi

/usr/bin/vncconfig -nowin &
exec /usr/bin/openbox-session
