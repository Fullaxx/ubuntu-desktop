#!/bin/bash

# if VNCUMASK was set at docker cmdline
# apply it to the whole openbox session (and every app started from it)
if [ -n "${VNCUMASK}" ]; then
  umask "${VNCUMASK}"
fi

# Skip the GTK accessibility bridge: there is no AT-SPI bus in the container,
# so every GTK app would log "AT-SPI: Error retrieving accessibility bus address"
export NO_AT_BRIDGE=1

/usr/bin/vncconfig -nowin &
# Run the session on a D-Bus session bus of its own, as a desktop login does (a VNC session gets none):
# the programs started from it share that one bus instead of starting their own, and it ends with the session
exec dbus-launch --exit-with-session /usr/bin/openbox-session
