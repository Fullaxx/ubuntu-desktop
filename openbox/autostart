#
# This script will run when an Openbox X Session is started.
# You may place a similar script in $HOME/.config/openbox/autostart
# to run user-specific things.
#

# https://github.com/jessfraz/dockerfiles/issues/4
# +si:localuser:root admits only root's own clients (local:root admitted every local connection)
xhost +si:localuser:root

fbpanel &

if [ -n "${WALLPAPER}" ]; then
  # quoted, so each value stays one argument
  /usr/bin/set_wallpaper.sh "${WALLPAPER}" "${WPLAYOUT}"
else
  hsetroot -solid "#333333"
fi
